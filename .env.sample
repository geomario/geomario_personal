# Copy to .env on the server and fill in. Used by docker-compose.deploy.yml.
# Keep comments on their own lines: Compose reads "KEY=  # note" as the value "# note".

# Database
DB_NAME=portfolio
DB_USER=portfolio
# REQUIRED: a strong password
DB_PASSWORD=

# Django
# REQUIRED: generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Admin user, created on first start if all three are set
DJANGO_SUPERUSER_USER=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# SSL / Domain
ACME_DEFAULT_EMAIL=email@example.com
DOMAIN=example.com
